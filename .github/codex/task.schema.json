{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_number",
    "revision",
    "base_sha",
    "objective",
    "acceptance_criteria",
    "permitted_paths",
    "permitted_operations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true
    },
    "permitted_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true
    },
    "permitted_operations": {
      "type": "array",
      "items": {
        "enum": [
          "add",
          "modify",
          "delete"
        ]
      },
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Canonical task snapshot. A future adapter injects verified Issue identity before parsing. Runtime policy validation is also mandatory."
}
