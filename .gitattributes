# NightRecon Git line-ending policy

# Let Git detect text files and normalize them in the repository.
* text=auto

# Source/config/documentation files use LF consistently.
*.py   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows-native scripts use CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
