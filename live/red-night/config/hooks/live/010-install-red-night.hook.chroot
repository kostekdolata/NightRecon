#!/bin/sh
set -eu

WHEEL_DIR=/opt/nightrecon/wheels
VENV_DIR=/opt/nightrecon/venv


require_one_wheel() {
    pattern="$1"
    set -- "$WHEEL_DIR"/$pattern
    if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
        echo "expected exactly one wheel matching $pattern" >&2
        exit 1
    fi
}

require_one_wheel "nightrecon_shared_core-*.whl"
require_one_wheel "nightrecon_red_engine-*.whl"
require_one_wheel "nightrecon_red_night-*.whl"

python3 -m venv "$VENV_DIR"
"$VENV_DIR/bin/python" -m pip install --disable-pip-version-check \
    "$WHEEL_DIR"/nightrecon_shared_core-*.whl \
    "$WHEEL_DIR"/nightrecon_red_engine-*.whl \
    "$WHEEL_DIR"/nightrecon_red_night-*.whl

"$VENV_DIR/bin/python" -c "from red_night_app.deployment import validate_red_deployment_contract; validate_red_deployment_contract()"

test -x "$VENV_DIR/bin/red-night-app"
test -x "$VENV_DIR/bin/red-night-appliance"
"$VENV_DIR/bin/red-night-appliance" --mode recovery-integrity --dry-run >/dev/null

ln -sf "$VENV_DIR/bin/red-night-app" /usr/local/bin/red-night-app
ln -sf "$VENV_DIR/bin/red-night-appliance" /usr/local/bin/red-night-appliance
rm -rf "$WHEEL_DIR"
