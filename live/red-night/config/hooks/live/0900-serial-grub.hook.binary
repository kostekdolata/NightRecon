#!/bin/sh
set -eu

GRUB_CFG=binary/boot/grub/grub.cfg
mkdir -p "$(dirname "$GRUB_CFG")"

cat > "$GRUB_CFG" <<'EOF'
set default=0
set timeout=0

serial --unit=0 --speed=115200 --word=8 --parity=no --stop=1
terminal_input serial
terminal_output serial

menuentry "Red Night Live" {
    linux /live/vmlinuz boot=live components hostname=red-night-live username=rednight console=ttyS0,115200n8
    initrd /live/initrd.img
}
EOF
