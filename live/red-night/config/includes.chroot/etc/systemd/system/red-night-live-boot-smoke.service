[Unit]
Description=Red Night Live Batch 3 boot and appliance marker
After=local-fs.target red-night-live-appliance.service
Wants=red-night-live-appliance.service
ConditionPathExists=/opt/nightrecon/venv/bin/python

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/red-night-live-boot-smoke

[Install]
WantedBy=multi-user.target
