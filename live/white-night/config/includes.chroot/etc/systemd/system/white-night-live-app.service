[Unit]
Description=White Night Live application bootstrap and mode gate
After=local-fs.target white-night-live-mode.service
Requires=white-night-live-mode.service
ConditionPathExists=/usr/local/bin/white-night-app

[Service]
Type=oneshot
ExecStart=/bin/sh /usr/local/sbin/white-night-live-app-start
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
