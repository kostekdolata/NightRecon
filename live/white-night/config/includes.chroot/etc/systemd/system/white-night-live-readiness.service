[Unit]
Description=White Night Live Batch 2 readiness marker
After=local-fs.target white-night-live-app.service
Requires=white-night-live-app.service
ConditionPathIsDirectory=/opt/nightrecon/wheels

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/white-night-live-readiness
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
