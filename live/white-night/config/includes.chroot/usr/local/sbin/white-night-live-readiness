#!/bin/sh
set -eu

wheel_dir=/opt/nightrecon/wheels
venv_dir=/opt/nightrecon/venv
python="$venv_dir/bin/python"
white_app="$venv_dir/bin/white-night-app"

require_one() {
    pattern=$1
    set -- "$wheel_dir"/$pattern
    if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
        echo "White Night Live readiness failed: expected exactly one $pattern" >&2
        exit 1
    fi
}

require_one 'nightrecon_shared_core-0.43.0-*.whl'
require_one 'nightrecon_white_engine-0.1.0a6-*.whl'
require_one 'nightrecon_white_night-0.1.0a6-*.whl'

test -x "$python"
test -x "$white_app"
test -L /usr/local/bin/white-night-app
test -s /run/white-night-live-app-start.txt
grep -Fq "White Night command boundary" /run/white-night-live-app-start.txt

"$python" - <<'PY'
import importlib.metadata as metadata
import importlib.util

assert metadata.version("nightrecon-shared-core") == "0.43.0"
assert metadata.version("nightrecon-white-engine") == "0.1.0a6"
assert metadata.version("nightrecon-white-night") == "0.1.0a6"
assert importlib.util.find_spec("nightrecon_red_engine") is None
PY

editions=/run/white-night-live-editions.json
"$white_app" editions --json > "$editions"

"$python" - "$editions" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    catalog = json.load(handle)

white = next(item for item in catalog if item["name"] == "White Night")
assert white["name"] == "White Night"
PY

marker=WHITE_NIGHT_LIVE_APP_OK
printf '%s\n' "$marker"
if [ -w /dev/ttyS0 ]; then
    printf '%s\n' "$marker" > /dev/ttyS0
fi
